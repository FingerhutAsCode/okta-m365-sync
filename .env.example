# ─── Okta ───────────────────────────────────────────────
OKTA_DOMAIN=https://yourorg.okta.com
OKTA_API_TOKEN=your_okta_api_token
OKTA_WEBHOOK_SECRET=your_okta_webhook_secret

# ─── Azure / Microsoft Graph ────────────────────────────
AZURE_TENANT_ID=your_tenant_id
AZURE_CLIENT_ID=your_client_id
AZURE_CLIENT_SECRET=your_client_secret

# ─── Behavior ───────────────────────────────────────────
# Comma-separated Okta group IDs to sync (leave blank to sync all)
OKTA_GROUP_FILTER=

# Target group type: m365 | distribution | both
TARGET_GROUP_TYPE=both

# Create group in M365 if it doesn't exist: true | false
AUTO_CREATE_GROUPS=true

# ─── Azure Deployment ───────────────────────────────────
AZURE_SUBSCRIPTION_ID=your_subscription_id
AZURE_RESOURCE_GROUP=rg-okta-m365-sync
AZURE_FUNCTION_APP_NAME=func-okta-m365-sync
AZURE_LOCATION=eastus
